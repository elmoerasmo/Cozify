<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.ProfileController"
            prefWidth="400" prefHeight="600"
            style="-fx-background-color: white;">

    <VBox spacing="20" alignment="CENTER"
          layoutX="50" layoutY="40" prefWidth="300">

        <ImageView fitWidth="180" fitHeight="180" preserveRatio="true">
            <image>
                <Image url="@/images/cozifylogo.png"/>
            </image>
        </ImageView>

        <Label fx:id="lblName"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label fx:id="lblEmail"
               style="-fx-font-size: 14px; -fx-text-fill: #666;"/>

        <Label fx:id="lblPhone"
               style="-fx-font-size: 14px; -fx-text-fill: #666;"/>

        <Button text="Edit Profile" onAction="#handleEditProfile"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;
                       -fx-background-radius: 20; -fx-padding: 10 20;"/>
        <Button fx:id="btnClose"
                text="Tutup"
                onAction="#handleClose"
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white;
                       -fx-background-radius: 20; -fx-padding: 10 20;"/>
        
        <Button fx:id="btnLogout" text="Logout" onAction="#handleLogout"/>

        <Button fx:id="btnRegisterOwner"
        text="Daftar sebagai Owner"
        onAction="#handleRegisterOwner"
        visible="false"
        style="-fx-background-color: #4CAF50; -fx-text-fill: white;
               -fx-background-radius: 20; -fx-padding: 10 20;"/>

        <Button fx:id="btnOwnerDashboard"
                text="Masuk Owner Dashboard"
                onAction="#handleOwnerDashboard"
                visible="false"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;
                       -fx-background-radius: 20; -fx-padding: 10 20;"/>

        
    </VBox>
</AnchorPane>
