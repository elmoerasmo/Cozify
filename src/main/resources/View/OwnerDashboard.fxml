<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="Controller.OwnerDashboardController"
            style="-fx-background-color: #f5f5f5; -fx-padding: 30 0 0 0;">
    
    <!-- Header -->
    <top>
        <HBox style="-fx-background-color: #8CC1E9; -fx-padding: 20 40;" alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="15" onMouseClicked="#goToDashboard">
                <Label text="COZIFY" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
                    
        </HBox>
    </top>
    
    <!-- Content -->
    <center>
        <VBox>
                      
            <!-- ==================== OWNER DASHBOARD ==================== -->
            <VBox fx:id="ownerDashboard" spacing="30" style="-fx-padding: 30 40;" >
                
                <!-- Notification Alert (if any rejection) -->
                <VBox fx:id="notificationBox" spacing="0" managed="false" visible="false"
                      style="-fx-background-color: #fff3cd; -fx-border-color: #ffc107; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="⚠️" style="-fx-font-size: 18;"/>
                        <VBox spacing="5">
                            <Label text="Notifikasi Penolakan Data" style="-fx-font-weight: bold; -fx-text-fill: #856404;"/>
                            <Label fx:id="lblNotificationMessage" text="Beberapa data Anda ditolak oleh admin. Silakan periksa dan perbaiki." 
                                   style="-fx-text-fill: #856404; -fx-font-size: 12;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#handleCloseNotification"
                                style="-fx-background-color: transparent; -fx-text-fill: #856404; -fx-font-size: 18; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
                
                <!-- Owner Statistics Cards -->
                <GridPane hgap="20" vgap="20">
                    
                    <VBox GridPane.columnIndex="0" prefWidth="250"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
                        <Label text="Total Kos" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblTotalKos" text="0"
                               style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #2196F3;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Properti terdaftar" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>

                    <VBox GridPane.columnIndex="1" prefWidth="250"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
                        <Label text="Total Kamar" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblTotalKamar" text="0"
                               style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #4CAF50;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Semua unit" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>

                    <VBox GridPane.columnIndex="2" prefWidth="250"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
                        <Label text="Kamar Terisi" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblKamarTerisi" text="0"
                               style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #FF9800;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Unit ditempati" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>

                    <VBox GridPane.columnIndex="3" prefWidth="250"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
                        <Label text="Pendapatan Bulan Ini" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblPendapatan" text="Rp 0"
                               style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #9C27B0;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Pemasukan aktif" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>

                </GridPane>
                
                <!-- Owner Tab Pane -->
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                         style="-fx-background-color: white; -fx-background-radius: 15;">

                    <!-- Tab 1: Data Kos Saya -->
                    <Tab text="🏠 Data Kos Saya">
                        <VBox spacing="20" style="-fx-padding: 25;">

                            <HBox spacing="12">
                                <Button text="+ Tambah Kos" onAction="#handleTambahKos"
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13;"/>
                                <Button text="🗑 Hapus" onAction="#handleHapusKos"
                                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                            </HBox>

                            <!-- Card Grid for My Kos -->
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                <FlowPane fx:id="myKosCardsContainer" hgap="20" vgap="20" style="-fx-padding: 10;">
                                    <!-- Cards will be added programmatically -->
                                </FlowPane>
                            </ScrollPane>
                            
                        </VBox>
                    </Tab>

                    <!-- Tab 2: Laporan Keuangan -->
                    <!-- Tab 2: Laporan Keuangan -->
                <Tab text="💰 Laporan Keuangan">
                    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
                        <VBox spacing="20" style="-fx-padding: 25;">

                            <VBox spacing="15" 
                                  style="-fx-background-color: #f9f9f9; -fx-padding: 20; -fx-background-radius: 10;">
                                <Label text="Filter Laporan" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                                <GridPane hgap="15" vgap="10">

                                    <Label text="Periode:" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                                           style="-fx-font-size: 13;"/>
                                    <ComboBox fx:id="cbPeriode" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Bulan Ini"/>
                                                <String fx:value="Bulan Lalu"/>
                                                <String fx:value="3 Bulan Terakhir"/>
                                                <String fx:value="6 Bulan Terakhir"/>
                                                <String fx:value="Tahun Ini"/>
                                            </FXCollections>
                                        </items>
                                    </ComboBox>

                                    <Label text="Kos:" GridPane.columnIndex="2" GridPane.rowIndex="0"
                                           style="-fx-font-size: 13;"/>
                                    <ComboBox fx:id="cbFilterKos" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Semua Kos"/>
                                            </FXCollections>
                                        </items>
                                    </ComboBox>

                                    <Button text="🔍 Tampilkan" onAction="#handleTampilkanLaporan"
                                            GridPane.columnIndex="4" GridPane.rowIndex="0"
                                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                                </GridPane>
                            </VBox>

                            <HBox spacing="20" 
                                  style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                                         -fx-padding: 30; -fx-background-radius: 15;">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label text="Total Pemasukan" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13;"/>
                                    <Label fx:id="lblTotalPemasukan" text="Rp 0"
                                           style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;">
                                        <padding><Insets top="8"/></padding>
                                    </Label>
                                </VBox>

                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label text="Total Pengeluaran" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13;"/>
                                    <Label fx:id="lblTotalPengeluaran" text="Rp 0"
                                           style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;">
                                        <padding><Insets top="8"/></padding>
                                    </Label>
                                </VBox>

                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label text="Keuntungan Bersih" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13;"/>
                                    <Label fx:id="lblKeuntungan" text="Rp 0"
                                           style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;">
                                        <padding><Insets top="8"/></padding>
                                    </Label>
                                </VBox>
                            </HBox>

                            <HBox spacing="12">
                                <Button text="📥 Export ke PDF" onAction="#handleExportPDF"
                                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                                <Button text="📥 Export ke Excel" onAction="#handleExportExcel"
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                            </HBox>

                            <!-- TABEL DIPERBESAR -->
                            <TableView fx:id="tblLaporan" prefHeight="550" minHeight="450"
                                       style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8;">
                                <columns>
                                    <TableColumn fx:id="colTanggal" text="Tanggal" prefWidth="100" minWidth="80"/>
                                    <TableColumn fx:id="colKosLaporan" text="Kos" prefWidth="180" minWidth="150"/>
                                    <TableColumn fx:id="colKategori" text="Kategori" prefWidth="130" minWidth="100"/>
                                    <TableColumn fx:id="colKeterangan" text="Keterangan" prefWidth="300" minWidth="200"/>
                                    <TableColumn fx:id="colPemasukan" text="Pemasukan" prefWidth="130" minWidth="100"/>
                                    <TableColumn fx:id="colPengeluaran" text="Pengeluaran" prefWidth="130" minWidth="100"/>
                                </columns>
                            </TableView>

                        </VBox>
                    </ScrollPane>
                </Tab>

                </TabPane>
                
            </VBox>
        </VBox>
    </center>
    
</BorderPane>