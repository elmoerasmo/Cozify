<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.DashboardController" fx:id="main">

    <children>
      <!-- Header -->
        <HBox alignment="CENTER" maxWidth="Infinity" prefHeight="106.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 10 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #dcdcdc;">
            <children>
                <ImageView fitHeight="106.0" fitWidth="170.0" preserveRatio="true">
                    <image>
                       <Image url="@/images/cozifylogo.png"/>
                    </image>
                </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS" maxWidth="800.0">
               <children>
                  <TextField fx:id="searchField" HBox.hgrow="ALWAYS" prefHeight="45.0"
                             promptText="Cari nama kos atau lokasi..."
                             style="-fx-background-radius: 25 0 0 25; -fx-border-color: #dcdcdc; -fx-border-radius: 25 0 0 25; -fx-padding: 0 20;" />
                  <Button fx:id="btnSearch" onAction="#handleSearch" prefHeight="45.0" prefWidth="60.0" 
                          text="🔍" 
                          style="-fx-background-color: #0894D3; -fx-text-fill: white; -fx-background-radius: 0 25 25 0; -fx-cursor: hand;" />
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnFavorit" text="⭐" style="-fx-font-size: 30; -fx-background-color: transparent; -fx-cursor: hand;" />
            <Button fx:id="profileButton" text="👤" prefHeight="40" prefWidth="40" style="-fx-background-radius: 20; -fx-background-color: #0894D3; -fx-text-fill: white; -fx-cursor: hand;" />
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
         <content>
            <VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: white;">
               <VBox maxWidth="Infinity" spacing="10" style="-fx-background-color: linear-gradient(to right, #00bfff, #47cbff); -fx-background-radius: 15; -fx-padding: 30;">
                  <children>
                     <Text style="-fx-fill: white; -fx-font-size: 30; -fx-font-weight: bold;" text="Temukan Kos Impianmu"/>
                     <Text style="-fx-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Nyaman, Aman, dan Terjangkau"/>
                  </children>
               </VBox>

               <HBox spacing="10">
                  <children>
                     <Button fx:id="semuaButton" text="Semua" style="-fx-background-radius: 20;"/>
                     <Button fx:id="putraButton" text="Putra" style="-fx-background-radius: 20;"/>
                     <Button fx:id="putriButton" text="Putri" style="-fx-background-radius: 20;"/>
                     <Button fx:id="campurButton" text="Campur" style="-fx-background-radius: 20;"/>
                     <Button fx:id="fasilitasButton" text="Fasilitas" style="-fx-background-radius: 20;"/>
                     <Region HBox.hgrow="ALWAYS"/>
                     <ComboBox fx:id="cbUrutkan" onAction="#handleSort" prefWidth="101" promptText="Urutkan" style="-fx-background-radius: 20;"/>
                  </children>
               </HBox>
               
               <HBox fx:id="suggestionContainer" spacing="5.0" visible="false" managed="false" style="-fx-padding: 0 5;">
                    <children>
                       <Text text="Maksud Anda: " style="-fx-fill: #666; -fx-font-style: italic;" />
                       <Hyperlink fx:id="hlSuggestion" onAction="#handleApplySuggestion" style="-fx-text-fill: #0894D3; -fx-font-weight: bold; -fx-padding: 0;" text="Nama Kos" />
                    </children>
                </HBox>

               <VBox fx:id="vBoxListKos" spacing="15" />
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
