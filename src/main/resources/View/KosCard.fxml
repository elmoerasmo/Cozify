<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="300.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-padding: 10;"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.KosCardController">

   <children>
      <ImageView fx:id="kosImage" fitHeight="278.0" fitWidth="359.0" pickOnBounds="true" preserveRatio="true" />
      
      <VBox alignment="CENTER_LEFT" spacing="5.0" HBox.hgrow="ALWAYS">
         <children>
            <Button fx:id="btnFavorite" mnemonicParsing="false" onAction="#handleFavoriteAction" text="Tambahkan Favorit" />
            <Region prefHeight="21.0" prefWidth="200.0" />
            <Label fx:id="lblTipe" style="-fx-background-color: #f0f0f0; -fx-padding: 2 8; -fx-background-radius: 5;" text="Tipe" textFill="#555555" />
            <Label fx:id="lblNama" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Nama Kos Rumah Deka" />
            <Label fx:id="lblFasilitas" text="WiFi • Kasur • Akses 24 Jam" textFill="#777777" />
            <Label fx:id="lblHarga" style="-fx-font-weight: bold; -fx-font-size: 14;" text="Rp1.000.000" />
         </children>
      </VBox>
   </children>
</HBox>
