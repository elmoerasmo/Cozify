<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.TableView?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="Controller.AdminDashboardController"
            style="-fx-background-color: #f5f5f5; -fx-padding: 30 0 0 0;">
    
    <!-- Header -->
    <top>
        <HBox style="-fx-background-color: #8CC1E9; -fx-padding: 20 40;" alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="COZIFY" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Single Switch Button -->
            <VBox alignment="CENTER_RIGHT" spacing="5">
<!--                <Button fx:id="btnSwitchRole" text="👨‍💼 Admin" onAction="#handleSwitchRole"
                        style="-fx-background-color: white; -fx-text-fill: #8CC1E9; -fx-padding: 10 20; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;"/>-->
            </VBox> 
        </HBox>
    </top>
    
    <!-- Content -->
    <center>
        <StackPane>
            
            <!-- ==================== ADMIN DASHBOARD ==================== -->
            <VBox fx:id="adminDashboard" spacing="30" style="-fx-padding: 30 40;">
                
                <!-- Admin Statistics Cards -->
                <GridPane hgap="20" vgap="20">
                    
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);" 
                          GridPane.columnIndex="0" prefWidth="250">
                        <Label text="Total Pemilik Kos" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblTotalOwners" text="0" style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #2196F3;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Pengguna terdaftar" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>
                    
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);" 
                          GridPane.columnIndex="1" prefWidth="250">
                        <Label text="Kos Terverifikasi" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblVerifiedCount" text="0" style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #4CAF50;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Properti aktif" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>
                    
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);" 
                          GridPane.columnIndex="2" prefWidth="250">
                        <Label text="Menunggu Verifikasi" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblPendingCount" text="0" style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #FF9800;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Perlu ditinjau" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>
                    
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);" 
                          GridPane.columnIndex="3" prefWidth="250">
                        <Label text="Ditolak" style="-fx-font-size: 13; -fx-text-fill: #888; -fx-font-weight: 500;"/>
                        <Label fx:id="lblRejectedCount" text="0" style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #f44336;">
                            <padding><Insets top="12"/></padding>
                        </Label>
                        <Label text="Tidak disetujui" style="-fx-font-size: 11; -fx-text-fill: #aaa;">
                            <padding><Insets top="5"/></padding>
                        </Label>
                    </VBox>
                    
                </GridPane>
                
                <!-- Admin Tab Pane -->
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                         style="-fx-background-color: white; -fx-background-radius: 15;">
                    
                    <!-- Tab 1: Pemilik Kos -->
                    <Tab text="👥 Pemilik Kos">
                        <VBox spacing="20" style="-fx-padding: 25;">
                            
                            <HBox spacing="12">
                                <Button text="✓ Verifikasi" onAction="#handleVerifyPemilik"
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                                <Button text="✗ Tolak" onAction="#handleRejectPemilik"
                                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                                <Button text="🗑 Hapus" onAction="#handleDeletePemilik"
                                        style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                            </HBox>
                            
                            <TableView fx:id="tblPemilik" VBox.vgrow="ALWAYS"
                                       style="-fx-background-color: transparent;">
                                <columns>
                                    <TableColumn fx:id="colPemilikId" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="colPemilikNama" text="Nama Pemilik" prefWidth="200"/>
                                    <TableColumn fx:id="colPemilikEmail" text="Email" prefWidth="220"/>
                                    <TableColumn fx:id="colPemilikPhone" text="No. Telepon" prefWidth="150"/>
                                    <TableColumn fx:id="colPemilikJumlahKos" text="Jumlah Kos" prefWidth="120"/>
                                    <TableColumn fx:id="colPemilikStatus" text="Status" prefWidth="150"/>
                                </columns>
                            </TableView>
                            
                        </VBox>
                    </Tab>
                    
                    <!-- Tab 2: Data Kos -->
                    <Tab text="🏠 Data Kos">
                        <VBox spacing="20" style="-fx-padding: 25;">
                            
                            <!-- Card Grid for Kos -->
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                <FlowPane fx:id="kosCardsContainer" hgap="20" vgap="20" style="-fx-padding: 10;">
                                    <!-- Cards will be added programmatically -->
                                </FlowPane>
                            </ScrollPane>
                            
                        </VBox>
                    </Tab>
                    
                    <!-- Tab 3: Menunggu Verifikasi -->
                    <Tab text="⏳ Menunggu Verifikasi">
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <VBox spacing="40" style="-fx-padding: 25;">
                                
                                <!-- Section: Pemilik Kos Menunggu Verifikasi -->
                                <VBox spacing="15" style="-fx-background-color: #f9f9f9; -fx-padding: 25; -fx-background-radius: 10;">
                                    <Label text="📋 Pemilik Kos Menunggu Verifikasi" 
                                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                                    
                                    <HBox spacing="12">
                                        <Button text="✓ Verifikasi" onAction="#handleVerifyPendingPemilik"
                                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                                        <Button text="✗ Tolak" onAction="#handleRejectPendingPemilik"
                                                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
                                    </HBox>
                                    
                                    <TableView fx:id="tblPendingPemilik" prefHeight="300"
                                               style="-fx-background-color: white;">
                                        <columns>
                                            <TableColumn fx:id="colPendingPemilikId" text="ID" prefWidth="60"/>
                                            <TableColumn fx:id="colPendingPemilikNama" text="Nama Pemilik" prefWidth="200"/>
                                            <TableColumn fx:id="colPendingPemilikEmail" text="Email" prefWidth="220"/>
                                            <TableColumn fx:id="colPendingPemilikPhone" text="No. Telepon" prefWidth="150"/>
                                            <TableColumn fx:id="colPendingPemilikTanggalDaftar" text="Tanggal Daftar" prefWidth="150"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                                
                                <!-- Section: Data Kos Menunggu Verifikasi -->
                                <VBox spacing="15" style="-fx-background-color: #f9f9f9; -fx-padding: 25; -fx-background-radius: 10;">
                                    <Label text="🏠 Data Kos Menunggu Verifikasi" 
                                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                                    
                                    <Label text="Klik pada kartu kos untuk melihat detail dan melakukan verifikasi/penolakan" 
                                           style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                                    
                                    <!-- Card Grid for Pending Kos -->
                                    <ScrollPane fitToWidth="true" prefHeight="500" style="-fx-background-color: transparent; -fx-background: transparent;">
                                        <FlowPane fx:id="pendingKosCardsContainer" hgap="20" vgap="20" style="-fx-padding: 10;">
                                            <!-- Cards will be added programmatically -->
                                        </FlowPane>
                                    </ScrollPane>
                                </VBox>
                                
                            </VBox>
                        </ScrollPane>
                    </Tab>
                    
                </TabPane>
                
            </VBox>
            
            <!-- ==================== OWNER DASHBOARD ==================== -->
           
        </StackPane>
    </center>
    
</BorderPane>