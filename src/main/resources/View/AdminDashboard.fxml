<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.AdminDashboardController">
    
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="20" style="-fx-background-color: #8CC1E9; -fx-padding: 0 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <children>
                <ImageView fitHeight="80.0" fitWidth="150.0" onMouseClicked="#goToDashboard" preserveRatio="true" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@/images/cozifylogo.png" />
                    </image>
                </ImageView>
                <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Admin Control Panel">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Text>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="profileButton" prefHeight="45.0" prefWidth="45.0" style="-fx-background-radius: 25; -fx-background-color: #0894D3; -fx-text-fill: white; -fx-font-size: 18;" text="👤" />
            </children>
        </HBox>
    </top>
    
    <center>
        <VBox spacing="30.0" style="-fx-padding: 30 40;">
            <children>
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <children>
                        <VBox prefHeight="120.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" GridPane.columnIndex="0">
                            <children>
                                <Label style="-fx-text-fill: #888;" text="Total Pemilik Kos" />
                                <Label fx:id="lblTotalOwners" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="0" />
                            </children>
                        </VBox>
                        <VBox prefHeight="120.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" GridPane.columnIndex="1">
                            <children>
                                <Label style="-fx-text-fill: #888;" text="Kos Terverifikasi" />
                                <Label fx:id="lblVerifiedCount" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="0" />
                            </children>
                        </VBox>
                        <VBox prefHeight="120.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" GridPane.columnIndex="2">
                            <children>
                                <Label style="-fx-text-fill: #888;" text="Menunggu Verifikasi" />
                                <Label fx:id="lblPendingCount" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #FF9800;" text="0" />
                            </children>
                        </VBox>
                        <VBox prefHeight="120.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" GridPane.columnIndex="3">
                            <children>
                                <Label style="-fx-text-fill: #888;" text="Ditolak" />
                                <Label fx:id="lblRejectedCount" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #f44336;" text="0" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <TabPane style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 10;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="👥 Manajemen Pemilik">
                            <VBox spacing="15.0" style="-fx-padding: 20;">
                                <children>
                                    <HBox spacing="10.0">
                                        <children>
                                            <Button onAction="#handleVerifyPemilik" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 8;" text="✓ Verifikasi Pemilik" />
                                            <Button onAction="#handleRejectPemilik" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 8;" text="✗ Tolak" />
                                            <Button onAction="#handleDeletePemilik" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-background-radius: 8;" text="🗑 Hapus" />
                                        </children>
                                    </HBox>
                                    <TableView fx:id="tblPemilik" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colPemilikId" prefWidth="50.0" text="ID" />
                                            <TableColumn fx:id="colPemilikNama" prefWidth="180.0" text="Nama Pemilik" />
                                            <TableColumn fx:id="colPemilikEmail" prefWidth="200.0" text="Email" />
                                            <TableColumn fx:id="colPemilikPhone" prefWidth="150.0" text="No. Telepon" />
                                            <TableColumn fx:id="colPemilikJumlahKos" prefWidth="100.0" text="Jumlah Kos" />
                                            <TableColumn fx:id="colPemilikStatus" prefWidth="150.0" text="Status" />
                                        </columns>
                                    </TableView>
                                </children>
                            </VBox>
                        </Tab>

                        <Tab text="⏳ Verifikasi Kos">
                            <VBox spacing="15.0" style="-fx-padding: 20;">
                                <children>
                                    <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Daftar Kos Menunggu Persetujuan" />
                                    <HBox spacing="10.0">
                                        <children>
                                            <Button onAction="#handleVerifyKos" prefHeight="35.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="✓ SETUJUI KOS" />
                                            <Button onAction="#handleRejectKos" prefHeight="35.0" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="✗ TOLAK KOS" />
                                        </children>
                                    </HBox>
                                    <TableView fx:id="tblPendingKos" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colKosId" prefWidth="60.0" text="ID" />
                                            <TableColumn fx:id="colKosNama" prefWidth="250.0" text="Nama Kos" />
                                            <TableColumn fx:id="colKosTipe" prefWidth="120.0" text="Tipe" />
                                            <TableColumn fx:id="colKosHarga" prefWidth="180.0" text="Harga (Bulan)" />
                                            <TableColumn fx:id="colKosStatus" prefWidth="200.0" text="Status Saat Ini" />
                                        </columns>
                                    </TableView>
                                </children>
                            </VBox>
                        </Tab>
                        
                        <Tab text="🏠 Database Kos">
                           <content>
                              <VBox spacing="15.0" style="-fx-padding: 20;">
                                 <children>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                       <content>
                                          <FlowPane fx:id="kosCardsContainer" hgap="20.0" vgap="20.0" />
                                       </content>
                                    </ScrollPane>
                                 </children>
                              </VBox>
                           </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </center>
</BorderPane>